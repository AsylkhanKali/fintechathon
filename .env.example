# FourEyes engine and dashboard settings. Copy to .env (git-ignored) and fill in.
# Zero-value testnet keys ONLY. Never commit .env.
# All transactions use zero-value testnet tokens; no real-value cryptocurrency or stablecoins.

# Chain: Base Sepolia (84532), or http://127.0.0.1:8545 for the local Anvil fallback (31337)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# The Planner's agent key (must be the key registered on the Treasury with setAgent)
AGENT_PRIVATE_KEY=

# Base Sepolia deployment (for Anvil, use the addresses in deployments/anvil.json)
TREASURY_ADDRESS=0xF265BbC1bdFeEa96e745225B7dd3f8E0e895c727
VAULT_ADDRESS=0x65Ce1bB77186BeC362Ca165787487404ddFba843
PRICE_FEED_ADDRESS=0x77681210D03afc2eD793CEB21A597CDC1CED3309

# LLM explainer: any OpenAI-compatible endpoint. Leave both empty to use the template fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Decision log (SQLite)
DECISIONS_DB_PATH=decisions.db

# LOCAL DEMO LAPTOP ONLY: lets the dashboard sign founder actions.
# Never set this in the repository or in any hosted deployment.
FOUNDER_DEMO_PRIVATE_KEY=
