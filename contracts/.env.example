# Base Sepolia (chain 84532) ONLY. Zero-value testnet keys ONLY. Never commit the real .env.
# All transactions use zero-value testnet tokens; no real-value cryptocurrency or stablecoins.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Founder key: deploys everything and becomes owner of Treasury and all mocks.
OWNER_PRIVATE_KEY=
# Agent hot-key ADDRESS only (the agent service holds its own key).
AGENT_ADDRESS=
# Optional: Etherscan v2 API key to verify contracts on sepolia.basescan.org.
ETHERSCAN_API_KEY=
# Optional: keccak256 of the canonical policy JSON, set at deploy time.
POLICY_HASH=
